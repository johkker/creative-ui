{
  "name": "creative-ui-agent",
  "version": "0.1.0",
  "description": "Framework-agnostic art direction, visual lineage and anti-slop tooling for AI coding agents.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "bin": {
    "creative-ui": "dist/index.js",
    "creative-ui-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johkker/creative-ui.git"
  },
  "homepage": "https://github.com/johkker/creative-ui#readme",
  "bugs": {
    "url": "https://github.com/johkker/creative-ui/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "frontend",
    "design",
    "art-direction",
    "creative-coding",
    "codex",
    "claude-code",
    "cursor",
    "cli",
    "design-system",
    "ui",
    "visual-lineage"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:packages": "pnpm -r build",
    "build:publish": "tsup --config tsup.publish.config.ts",
    "build": "pnpm build:packages && pnpm build:publish",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "verify": "pnpm typecheck && pnpm build:publish && npm pack --dry-run",
    "prepublishOnly": "pnpm verify",
    "creative-ui": "pnpm --filter @creative-ui/cli dev --",
    "dev": "pnpm creative-ui init"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ink": "^5.2.1",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
